<script>

window.addEventListener('scroll', function () {
const header = document.querySelector('header');
if (window.scrollY > 50) {
header.classList.add('scrolled');
document.querySelector('.navbar-brand').classList.remove('text-light');
document.querySelector('.navbar-brand').classList.add('text-dark');
} else {
header.classList.remove('scrolled');
document.querySelector('.navbar-brand').classList.remove('text-dark');
document.querySelector('.navbar-brand').classList.add('text-light');
}
});
</script>
<script>
document.addEventListener("DOMContentLoaded", () => {
// 🎲 Random tilt + pin/tape + random swing offset
document.querySelectorAll('.polaroid').forEach(el => {
let angle = (Math.random() * 16 - 8).toFixed(1);
el.style.setProperty('--tilt', angle + 'deg');
el.style.transform = `rotate(${angle}deg)`;

let delay = (Math.random() * 3).toFixed(2);
el.style.setProperty('--rand', delay);

if (Math.random() > 0.5) {
let pin = document.createElement("span");
pin.classList.add("pin");
el.appendChild(pin);
} else {
let tape = document.createElement("span");
tape.classList.add("tape");
el.appendChild(tape);
}
});

// Shuffle helper
function shuffle(array) {
for (let i = array.length - 1; i > 0; i--) {
const j = Math.floor(Math.random() * (i + 1));
[array[i], array[j]] = [array[j], array[i]];
}
return array;
}

// Sorting logic
document.querySelectorAll('#filterTabs a').forEach(tab => {
tab.addEventListener('click', function(e) {
e.preventDefault();
document.querySelectorAll('#filterTabs a').forEach(t => t.classList.remove('active'));
this.classList.add('active');

let filter = this.getAttribute('data-filter');
let items = Array.from(document.querySelectorAll('.gallery-item'));

// Shuffle on every sort
let shuffled = shuffle(items);
shuffled.forEach(item => item.parentNode.appendChild(item));

// Staggered drop-in
items.forEach((item, i) => {
if (filter === "all" || item.classList.contains(filter)) {
setTimeout(() => item.classList.remove('hide'), i * 120);
} else {
item.classList.add('hide');
}
});
});
});
});
</script>
<script>
// Simple share links (replace location.href + title)
const pageUrl = encodeURIComponent(location.href);
const pageTitle = encodeURIComponent(document.title);
document.addEventListener('DOMContentLoaded', () => {
const shareFb = document.getElementById('share-fb');
if (shareFb) {
const pageUrlFb = encodeURIComponent(window.location.href);
shareFb.href = `https://www.facebook.com/sharer/sharer.php?u=${pageUrlFb}`;
}
});
document.addEventListener('DOMContentLoaded', () => {
const shareTw = document.getElementById('share-tw');
if (shareTw) {
const pageUrlTw = encodeURIComponent(window.location.href);
shareTw.href = `https://twitter.com/intent/tweet?url=${pageUrlTw}&text=${pageTitle}`;
}
});
document.addEventListener('DOMContentLoaded', () => {
const shareLn = document.getElementById('share-ln');
if (shareLn) {
const pageUrlLn = encodeURIComponent(window.location.href);
shareLn.href = `https://www.linkedin.com/shareArticle?mini=true&url=${pageUrl}&title=${pageTitle}`;
}
});
document.addEventListener('DOMContentLoaded', () => {
const shareFb = document.getElementById('share-fb');
const shareFbInline = document.getElementById('share-fb-inline');
const shareTw = document.getElementById('share-tw');
const shareTwInline = document.getElementById('share-tw-inline');
const shareLn = document.getElementById('share-ln');
const shareLnInline = document.getElementById('share-ln-inline');



if (shareFb && shareFbInline) {
shareFbInline.href = shareFb.href;
}else if(shareTw && shareTwInline) {
shareTwInline.href = shareTw.href;
}else if(shareLn && shareLnInline) {
shareLnInline.href = shareLn.href;
}
});

</script>

