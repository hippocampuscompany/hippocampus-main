<style>
/* Buttons */
.enquiry-btn {
  display: inline-block;
  padding: 10px 24px;
  border-radius: 50px;
  font-weight: 600;
  text-decoration: none;
  margin: 6px;
  transition: all 0.3s ease;
}

.enquiry-primary {
  background: linear-gradient(90deg, #f04e43, #fcd84e);
  color: #fff;
}

.enquiry-outline {
  border: 2px solid #f04e43;
  color: #f04e43;
}

.enquiry-btn:hover {
  background: linear-gradient(90deg, #f04e43, #fcd84e);
  color: #fff;
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(240, 78, 67, 0.35);
}

/* Modal */
.admission-modal {
  border-radius: 20px;
  overflow: hidden;
  border: none;
  box-shadow: 0 30px 70px rgba(0, 0, 0, 0.25);
}

/* Header */
.admission-header {
  background: linear-gradient(90deg, #f04e43, #fcd84e);
  padding: 18px 22px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* Body */
.admission-body {
  background: #ffffff;
  padding: 24px;
}

/* Inputs */
.form-control,
.form-select {
  border-radius: 12px;
}

.form-control:focus,
.form-select:focus {
  border-color: #f04e43;
  box-shadow: 0 0 0 3px rgba(240, 78, 67, 0.15);
}

/* Submit */
.submit-btn {
  background: linear-gradient(90deg, #f04e43, #fcd84e);
  color: #fff;
  font-weight: 600;
  border-radius: 50px;
  padding: 12px;
  border: none;
}

.submit-btn:hover {
  box-shadow: 0 10px 25px rgba(240, 78, 67, 0.4);
}

</style>



