---
layout: layout.njk
pagination:
  data: blogs
  size: 1
  alias: blog
permalink: "/blogs/{{ blog.slug }}/"
---



 <style>
    :root{
      --accent:#0f52ba;    /* provided */
      --dark:#101B42;      /* provided */
      --muted:#6c757d;
      --card-shadow: 0 6px 18px rgba(16,27,66,0.06);
      --radius:14px;
    }

    /* HERO / ARTICLE HEADER */
    .article-hero{
      padding: 150px 0 28px;
      border-bottom: 1px solid #eef2f7;
    }
    .article-title{
      font-size: clamp(1.6rem, 2.6vw, 2.4rem);
      font-weight: 800;
      color: var(--dark);
      margin-bottom: .6rem;
      letter-spacing: -0.3px;
    }
    .meta-row { color: var(--muted); font-size: .95rem; }
    .author-avatar{
      width:48px; height:48px; border-radius:50%; object-fit:cover; border:2px solid #fff; box-shadow:0 2px 8px rgba(0,0,0,0.08);
    }

    /* FEATURE IMAGE */
    .feature-img {
      border-radius: 12px;
      width:100%;
      height: auto;
      object-fit:cover;
      box-shadow: var(--card-shadow);
    }
    .img-caption { color: var(--muted); font-size:.9rem; margin-top:.5rem; }

    /* ARTICLE CONTENT */
    article h2 { margin-top:1.25rem; color:var(--dark); font-weight:700; }
    article p { color:#1f2a44; font-size:1rem; }
    article blockquote{
      border-left:4px solid var(--accent);
      padding: .8rem 1rem;
      background: #f8fdfd;
      margin: 1.2rem 0;
      border-radius:8px;
      color: #0f3040;
    }
    article pre {
      background:#0f1724; color: #e6eef6; padding:1rem; border-radius:10px; overflow:auto;
    }
    article .read-time { color: var(--muted); font-size:.95rem; }

    /* SIDEBAR */
    .sticky-sidebar { position: sticky; top: 15%; }
    .related-card { border-radius: 10px; overflow: hidden; display:flex; gap:.8rem; align-items:center; padding:.8rem; box-shadow:var(--card-shadow); }
    .related-card img { width:84px; height:64px; object-fit:cover; border-radius:8px; flex-shrink:0; }

    /* SHARE BAR (floating on mobile and desktop inline) */
    .share-inline a { color:var(--muted); margin-right:.6rem; font-size:1.05rem; }
    .floating-share {
      display:none;
      position: fixed;
      left: 18px;
      top: 65%;
      background: rgba(255,255,255,0.97);
      border-radius: 12px;
      padding: 8px;
      box-shadow: 0 8px 26px rgba(16,27,66,0.08);
    }
    .floating-share a { display:block; padding:.55rem; color:var(--accent); font-size:1.15rem; }

    /* NEWSLETTER */
    .newsletter-card { border-radius: 12px; padding: 16px; box-shadow: var(--card-shadow); background: linear-gradient(180deg,#ffffff,#fcfffe); }

    /* FOOTER CTA */
    .article-footer-cta { background: linear-gradient(90deg, rgba(6,116,115,0.06), rgba(16,27,66,0.03)); border-radius: 12px; padding: 20px; margin-top: 30px; }

    /* responsive tweaks */
    @media (min-width: 992px){
      .floating-share { display:block; }
    }
    @media (max-width: 575px){
      .share-inline { display:none; }
    }
.badge{
background-color:#0f52ba;
}

  /* Hover effect for breadcrumb links */
  .hover-effect:hover {
    color: #0d6efd; /* Bootstrap primary color */
    text-decoration: underline;
  }

  /* Optional: smaller spacing between breadcrumb items */
  .breadcrumb-item + .breadcrumb-item::before {
    padding: 0 0.5rem;
  }

ul {
            list-style-type: disc; 
            padding-left: 20px; 
            }
  </style>
 <!-- floating share (desktop) -->
  <div class="floating-share d-none d-lg-block">
    <a class="d-inline-block" href="#" id="share-fb" title="Share on Facebook"><i class="bi bi-facebook"></i></a>
    <a class="d-inline-block" href="#" id="share-tw" title="Share on Twitter"><i class="bi bi-twitter"></i></a>
    <a class="d-inline-block" href="#" id="share-ln" title="Share on LinkedIn"><i class="bi bi-linkedin"></i></a>
  </div>


 <section class="article-hero">
	<div class="container">
    <!-- MAIN ARTICLE + SIDEBAR -->
    <div class="row my-3 gx-5">
      <div class="col-lg-8">    
<!-- Modern Blog Breadcrumb -->
<nav aria-label="breadcrumb" class="my-3">
  <ol class="breadcrumb bg-transparent p-0 mb-0 d-flex align-items-center" style="--bs-breadcrumb-divider: '>'; font-size: 0.9rem;">
    <li class="breadcrumb-item">
      <a href="/" class="text-decoration-none text-muted hover-effect">Home</a>
    </li>
    <li class="breadcrumb-item">
      <a href="/blogs" class="text-decoration-none text-muted hover-effect">Blogs</a>
    </li>
    <li class="breadcrumb-item active text-dark" aria-current="page">
      {{ blog.slug }}
    </li>
  </ol>
</nav>
        <!-- article body -->



          <h1 class="article-title">{{ blog.title }}</h1>
		<!-- Article Meta with Icons -->
<div class="d-flex flex-wrap align-items-center gap-3 my-3">
  <!-- Category Badge -->
  {% for category in blog.categories %}
  <a href="/blogs/category/{{ category.slug }}/"
     class="badge rounded-pill text-decoration-none"
     style="background:var(--accent); color:#fff; font-weight:700; padding:.45rem .7rem;">
     {{ category.name }}
  </a>
{% endfor %}

  <!-- Published Date -->
  <div class="text-muted small d-flex align-items-center gap-1">
    <i class="bi bi-calendar-event"></i>
    {{ blog.blogPublishedAt }}
  </div>

  <!-- Read Time -->
  <div class="text-muted small d-flex align-items-center gap-1">
    <i class="bi bi-clock"></i>
    {{ blog.readTime }}
  </div>

  <!-- Summarize in ChatGPT -->
  <div class="text-muted small d-flex align-items-center gap-1">
    <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="icon-lg"><path d="M11.2475 18.25C10.6975 18.25 10.175 18.1455 9.67999 17.9365C9.18499 17.7275 8.74499 17.436 8.35999 17.062C7.94199 17.205 7.50749 17.2765 7.05649 17.2765C6.31949 17.2765 5.63749 17.095 5.01049 16.732C4.38349 16.369 3.87749 15.874 3.49249 15.247C3.11849 14.62 2.93149 13.9215 2.93149 13.1515C2.93149 12.8325 2.97549 12.486 3.06349 12.112C2.62349 11.705 2.28249 11.2375 2.04049 10.7095C1.79849 10.1705 1.67749 9.6095 1.67749 9.0265C1.67749 8.4325 1.80399 7.8605 2.05699 7.3105C2.30999 6.7605 2.66199 6.2875 3.11299 5.8915C3.57499 5.4845 4.10849 5.204 4.71349 5.05C4.83449 4.423 5.08749 3.862 5.47249 3.367C5.86849 2.861 6.35249 2.465 6.92449 2.179C7.49649 1.893 8.10699 1.75 8.75599 1.75C9.30599 1.75 9.82849 1.8545 10.3235 2.0635C10.8185 2.2725 11.2585 2.564 11.6435 2.938C12.0615 2.795 12.496 2.7235 12.947 2.7235C13.684 2.7235 14.366 2.905 14.993 3.268C15.62 3.631 16.1205 4.126 16.4945 4.753C16.8795 5.38 17.072 6.0785 17.072 6.8485C17.072 7.1675 17.028 7.514 16.94 7.888C17.38 8.295 17.721 8.768 17.963 9.307C18.205 9.835 18.326 10.3905 18.326 10.9735C18.326 11.5675 18.1995 12.1395 17.9465 12.6895C17.6935 13.2395 17.336 13.718 16.874 14.125C16.423 14.521 15.895 14.796 15.29 14.95C15.169 15.577 14.9105 16.138 14.5145 16.633C14.1295 17.139 13.651 17.535 13.079 17.821C12.507 18.107 11.8965 18.25 11.2475 18.25ZM7.17199 16.1875C7.72199 16.1875 8.20049 16.072 8.60749 15.841L11.7095 14.059C11.8195 13.982 11.8745 13.8775 11.8745 13.7455V12.3265L7.88149 14.62C7.63949 14.763 7.39749 14.763 7.15549 14.62L4.03699 12.8215C4.03699 12.8545 4.03149 12.893 4.02049 12.937C4.02049 12.981 4.02049 13.047 4.02049 13.135C4.02049 13.696 4.15249 14.213 4.41649 14.686C4.69149 15.148 5.07099 15.511 5.55499 15.775C6.03899 16.05 6.57799 16.1875 7.17199 16.1875ZM7.33699 13.498C7.40299 13.531 7.46349 13.5475 7.51849 13.5475C7.57349 13.5475 7.62849 13.531 7.68349 13.498L8.92099 12.