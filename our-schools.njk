    "Vidyakula Hippocampus School"
  ],
  "Belgaum": [
    "Sri Basaveshwara Hippocampus English Medium School",
    "DB Darure Hippocampus English Medium School"
  ],
  "Koppal": [
    "Millennium Hippocampus School (CBSE)"
  ],
  "Guntur": [
    "Natco School of Learning"
  ],
  "Ramanagara": [
    "SSVM Hippocampus English Medium School"
  ],
  "Gulbarga": [
    "Siddh Bharati Vidya Mandir CBSE Secondary School"
  ],
  "Bidar": [
    "Sri Siddharoodh Public School"
  ],
  "Sagar": [
    "Jnanasagara Public School"
  ],
  "Rabakavi-Banahatti": [
    "Shri Prabhulingeshwar International School"
  ],
  "Gokak": [
    "Netaji Hippocampus English Medium School"
  ],
  "Rangareddy": [
    "Hippocampus School"
  ]
};

const citySelect = document.getElementById("citySelect");
const schoolSelect = document.getElementById("schoolSelect");

/* Populate City Dropdown */
Object.keys(schoolData).sort().forEach(city => {
  const option = document.createElement("option");
  option.value = city;
  option.textContent = city;
  citySelect.appendChild(option);
});

/* On City Change */
citySelect.addEventListener("change", function () {
  const selectedCity = this.value;
  schoolSelect.innerHTML = '<option value="">-- Select School --</option>';
  schoolSelect.disabled = true;

  if (!selectedCity) return;

  const schools = schoolData[selectedCity];

  schools.forEach(school => {
    const option = document.createElement("option");
    option.value = school;
    option.textContent = school;
    schoolSelect.appendChild(option);
  });

  schoolSelect.disabled = false;

  // Auto-select if only one school
  if (schools.length === 1) {
    schoolSelect.selectedIndex = 1;
  }
});
</script>

