              <select id="formCitySelect" name="city" class="form-select" required>
                <option value="">-- Select City --</option>
              </select>
            </div>

            <!-- School Dropdown -->
            <div class="col-md-4 form-group mt-3">
              <select id="formSchoolSelect" name="school" class="form-select" disabled required>
                <option value="">-- Select School --</option>
              </select>
            </div>

          </div>

          <div class="text-center mt-4">
            <button class="btn btn-warning btn-hippo" type="submit">Submit</button>
          </div>

