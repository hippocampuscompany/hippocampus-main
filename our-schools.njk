---
layout: layout.njk
title: Hippocampus Learning Centres
---


{% set page = null %}

{% for p in pages %}
  {% if p.slug == "our-school" %}
    {% set page = p %}
  {% endif %}
{% endfor %}

{% if page %}

{% set testimonialSection = null %}
{% for s in page.sections %}
  {% if s.__component == "page-sections.testimonial-slider" %}
    {% set testimonialSection = s %}
  {% endif %}
{% endfor %}




  {% for section in page.sections %}
    {% if section.__component == "page-sections.hero" %}

      <section class="academy-container position-relative">
        <div class="container">
          <div class="row g-4 pt-3">

            <div class="col-md-7 my-auto">
              <h3 class="fw-bold text-white mb-3 heading-responsive">
                {{ section.heading }}
              </h3>
            </div>

            <div class="col-md-5 my-auto">
              {% if section.videoUrl %}
                <div class="video-wrapper">
                  <iframe
                    width="100%"
                    height="315"
                    src="{{ section.videoUrl }}"
                    allowfullscreen>
                  </iframe>
                </div>
              {% endif %}
            </div>

          </div>
        </div>
      </section>

    {% endif %}
  {% endfor %}

{% endif %}







<style>
.academy-container{
      padding: 150px 0 60px 0 !important;
}
</style>

<style>
.video-wrapper {
position: relative; 
}

.video-wrapper::before,
.video-wrapper::after {
content: "";
position: absolute;
width: 40px;   /* length of lines */
height: 40px;
border: 2px solid #fff; /* line color */
}

.video-wrapper::before {
top: -10px;
left: -10px;
border-right: none;
border-bottom: none;
}

.video-wrapper::after {
bottom: -10px;
right: -10px;
border-left: none;
border-top: none;
}

/* Responsive heading */
.heading-responsive {
font-size: clamp(2rem, 6vw, 4.5rem); 
line-height: 1.2;
}
.academy-container {
background: linear-gradient(135deg, #5a2ca0, #7b42f6); /* optional bg */
padding: 60px 0;
}
</style>





<!-- My Schools Section -->

<section class="py-5">
  <div class="container">
    <h2 class="text-center mb-5 fw-bold">Our Schools</h2>

  <!-- Filters -->
<div class="d-flex flex-wrap justify-content-center align-items-center gap-3 mb-4">

  <!-- Board Tabs -->
  <ul class="nav nav-pills" id="filterTabs">
    <li class="nav-item mx-2">
      <button class="nav-link active" data-group="all">All Schools</button>
    </li>
    <li class="nav-item mx-2">
      <button class="nav-link" data-group="cbse">CBSE Board</button>
    </li>
    <li class="nav-item mx-2">
      <button class="nav-link" data-group="state">State Board</button>
    </li>
  </ul>

  <!-- City Dropdown (ONLY ONE) -->
 <select id="citySelect1" class="form-select w-auto">
    <option value="all">All Locations</option>
  </select>
  
</div>

<p id="schoolCountText" class="text-start mb-4 fw-semibold">
  Showing all schools
</p>


    <!-- Schools Grid -->
    <div class="row g-4 my-shuffle" id="schoolsGrid">

