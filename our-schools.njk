<script>
const schoolData = {
  "Bangalore": [
    "Vidya Vaibhav Hippocampus Public School",
    "Rayen Hippocampus Vidya Mandira School"
  ],
  "Hassan": [
    "Malnad International Hippocampus School",
    "Malenadu Future School"
  ],
  "Mandya": [
