<script>
document.addEventListener("DOMContentLoaded", function () {
  const tabs = document.querySelectorAll('#filterTabs button');
  const citySelect = document.getElementById('citySelect');
  const cards = document.querySelectorAll('.school-card');
  const displayText = document.getElementById('schoolCountText');

  let activeGroup = 'all';
  let activeCity = 'all';

  function populateCities() {
    const cities = new Set();

    cards.forEach(card => {
      const groups = JSON.parse(card.dataset.groups);
      const city = card.dataset.city;

      if (activeGroup === 'all' || groups.includes(activeGroup)) {
        cities.add(city);
      }
    });

    citySelect.innerHTML = `<option value="all">All Locations</option>`;
    [...cities].sort().forEach(city => {
      citySelect.innerHTML += `<option value="${city}">${city}</option>`;
    });

    activeCity = 'all';
    citySelect.value = 'all';
  }

  function applyFilters() {
    let visibleCount = 0;

    cards.forEach(card => {
      const groups = JSON.parse(card.dataset.groups);
      const city = card.dataset.city;

      const matchGroup =
        activeGroup === 'all' || groups.includes(activeGroup);

      const matchCity =
        activeCity === 'all' || city === activeCity;

      if (matchGroup && matchCity) {
        card.style.display = 'block';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    if (activeGroup === 'all' && activeCity === 'all') {
      displayText.textContent = `Showing all schools`;
    } else if (activeCity !== 'all' && activeGroup === 'all') {
      displayText.textContent = `Showing ${visibleCount} schools in ${activeCity}`;
    } else if (activeCity === 'all') {
      displayText.textContent = `Showing ${visibleCount} ${activeGroup.toUpperCase()} schools`;
    } else {
      displayText.textContent = `Showing ${visibleCount} ${activeGroup.toUpperCase()} schools in ${activeCity}`;
    }
  }

  tabs.forEach(tab => {
    tab.addEventListener('click', function () {
      tabs.forEach(t => t.classList.remove('active'));
      this.classList.add('active');
      activeGroup = this.dataset.group;
      populateCities();
      applyFilters();
    });
  });

  citySelect.addEventListener('change', function () {
    activeCity = this.value;
    applyFilters();
  });

  populateCities();
  applyFilters();
});
</script>

