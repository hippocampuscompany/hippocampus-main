{% include "global-scripts.njk" %}
<script>
document.addEventListener("DOMContentLoaded", () => {
document.querySelectorAll(".blog-card").forEach(card => {
const link = card.querySelector("a");
if (link) {
card.style.cursor = "pointer";
card.addEventListener("click", () => {
window.location.href = link.href;
});
}
});
});
</script>
<script>
document.addEventListener('DOMContentLoaded', () => {
const authorToggle = document.querySelector('.accordion-toggle');
const authorCollapse = document.getElementById('authorInfo');

if (authorCollapse && authorToggle) {
authorCollapse.addEventListener('show.bs.collapse', () => {
authorToggle.style.transform = 'rotate(180deg)';
});
authorCollapse.addEventListener('hide.bs.collapse', () => {
authorToggle.style.transform = 'rotate(0deg)';
});
}
});
</script>