---
layout: layout.njk
title: Blogs
---
{% set featured = blogs[0] %}
{% set others = blogs | slice(1, blogs.length) %}

<style>
.hero-section {
font-weight: 700;
font-size: 1.5rem;
margin-bottom: 1rem;
}
.card {
border: none;
border-radius: 12px;
overflow: hidden;
box-shadow: 0 2px 6px rgba(0,0,0,0.05);
transition: transform 0.2s ease;
position: relative;
}
.card:hover {
transform: translateY(-4px);
}
.card img {
object-fit: cover;
}
.category {
font-size: 0.8rem;
font-weight: 600;
color: #0f52ba;
text-transform: uppercase;
}
.pagination .page-link {
color: #0f52ba;
border-radius: 6px;
margin: 0 4px;
}
.pagination .active .page-link {
background-color: #0f52ba;
border-color: #0f52ba;
color: #fff;
}

/* Play button overlay */
.video-card {
position: relative;
cursor: pointer;
}
.video-card img {
width: 100%;
height: 220px;
object-fit: fill;
}

.play-btn {
position: absolute;
bottom: 15px;
left: 15px;
background: rgba(0,0,0,0.6);
color: #fff;
font-size: 1.5rem;
padding: 8px 14px;
border-radius: 50%;
text-decoration: none;
transition: background 0.3s ease;
}
.play-btn:hover {
background: rgba(0,0,0,0.85);
}

.newsletter {
background: linear-gradient(90deg, #0f52ba, #682dc9);
border-radius: 16px;
padding: 2rem;
margin-top: 4rem;
text-align: center;
box-shadow: 0 3px 10px rgba(0,0,0,0.05);
}
.newsletter h5 {
font-weight: 700;
margin-bottom: 0.5rem;
}
.newsletter p {
color: #fff;
margin-bottom: 1rem;
}
.newsletter input {
max-width: 350px;

}
.newsletter .btn {
background-color: #0f52ba;
color: #fff;
border-radius: 8px;
padding: 0.6rem 1.2rem;
}
.newsletter .btn:hover {
background-color: #055c5c;
}
.partners {
margin-top: 2rem;
font-size: 0.85rem;
color: #fff;
}
.partners img {
max-height: 28px;
margin: 0 8px;
opacity: 0.7;
}
.academy-container{
padding-top:150px;
}
.blog-title {
display: -webkit-box;
-webkit-line-clamp: 2;     /* show only 2 lines */
-webkit-box-orient: vertical;
overflow: hidden;
text-overflow: ellipsis;
min-height: 48px;          /* keeps card heights equal */
line-height: 1.4;
}
.blog-excerpt {
display: -webkit-box;
-webkit-line-clamp: 2;
-webkit-box-orient: vertical;
overflow: hidden;
min-height: 42px;
}
.blog-img-wrap {
width: 100%;
height: 172px;          /* control card image height */
overflow: hidden;
border-top-left-radius: 12px;
border-top-right-radius: 12px;
}

.blog-img-wrap img {
width: 100%;
height: 100%;
object-fit: cover;      /* 🔥 makes all images same size */
object-position: center;
}
</style>
<section class="academy-container position-relative">
<div class="container">  
<div class="row g-4">
<div class="col-md-12 my-auto py-5 ">
<h1 class="fw-normal fw-bold  text-center text-white">Inside Hippocampus — Beyond Classrooms</h1>
<h2 class="text-start text-white mb-2">Stay updated with the latest trends, research, and innovations shaping the future of learning, teaching, and school development at Hippocampus.</h2>

<div class="d-md-flex d-block justify-content-center mt-4">
<input type="email" class="form-control w-25 w-100 me-2" placeholder="Enter your work email">
<button class="btn btn-warning display-7 mx-auto mt-3 px-4">Subscribe</button>
</div>
</div>     
</div>
</div>
</section>
<div class="container py-5">
<!-- Featured Blogs -->
<section class="py-5 bg-light">
<div class="container">
<h1 class="section-title">Featured</h1>
<div class="row g-4">
<div class="col-lg-6">
<div class="card blog-card border-0 shadow-sm">

<img src="http://localhost:1337{{ featured.featuredImage.url }}" class="img-fluid" alt="">

<div class="card-body">
<h5 class="card-title fw-bold">{{ featured.title }}</h5>
<p class="card-text">{{ featured.excerpt }}</p>

<a href="/blogs/{{ featured.slug }}/" class="text-decoration-none fw-semibold">
{{ featured.readTime }}
</a>
</div>

</div>
</div>
<!-- Card 2 -->
<div class="col-lg-6">
<div class="row g-4">
{% for blog in blogs %}
{% if not loop.first %}

<div class="col-md-6">
<div class="card blog-card border-0 shadow-sm">
<div class="blog-img-wrap">
<img src="http://localhost:1337{{ blog.featuredImage.url }}" alt="">
</div>


<div class="card-body">
<h6 class="fw-bold blog-title">{{ blog.title }}</h6>
<p class="small blog-excerpt">{{ blog.excerpt }}</p>

<a href="/blogs/{{ blog.slug }}/" class="text-decoration-none fw-semibold">
{{ blog.readTime }}
</a>
</div>

</div>
</div>

{% endif %}
{% endfor %}

</div>
</div>
</div>
</div>
</div>
</section>
<!-- What's New -->
