        <div class="timeline-img" data-aos="fade-left" data-aos-delay="200">
         {% if item.image and item.image.url %}
  <img src="http://localhost:1337{{ item.image.url }}" alt="{{ item.year }}" class="img-fluid rounded-4 shadow">
{% endif %}
        </div>
      {% endif %}

      <div class="timeline-content {% if isEven %}right{% else %}left{% endif %}" 
     data-aos="fade-right" 
