<style>
/* =====================================================
   KBC SLIDER – FINAL, CLEAN, PRODUCTION CSS
   Scoped. Stable. Balanced. Non-plain.
   ===================================================== */

:root {
  --color-primary: #674ea7;
  --color-secondary: #fcd84e;


  --color-default: #1f1f1f;
}

/* ==============================
   SECTION WRAPPER (SCOPED)
   ============================== */
.kbc-slider-section {
  background: linear-gradient(180deg, #f7f5fb 0%, #ffffff 100%);
  padding: 60px 20px;
  border-radius: 32px;
}

/* Only affect grid inside this section */
.kbc-slider-section > .row > .col-md-4 {
  display: flex;
}

/* ==============================
   SWIPER SAFETY
   ============================== */
.kbc-slider-section .swiper {
  width: 100%;
  overflow: hidden;
  padding-bottom: 28px;
}

.kbc-slider-section .swiper-slide {
  width: 100% !important;
  display: flex;
  justify-content: center;
}

/* ==============================
   CARD BASE (ALL TYPES)
   ============================== */
.kbc-slider-section .kbc-card,
.kbc-slider-section .behavior-item,
.kbc-slider-section .competency-card {
  width: 100%;
  min-height: 380px;
  background: linear-gradient(180deg, #ffffff 0%, #fbfaff 100%);
  border-radius: 20px;
  padding: 48px 28px 60px;
  text-align: center;
  box-shadow: 0 14px 36px rgba(0,0,0,.08);
  box-sizing: border-box;
  position: relative;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
}

/* ==============================
   ICON SYSTEM (UNIFIED)
   ============================== */
.kbc-slider-section .icon-wrap {
  width: 90px;
  height: 90px;
  border-radius: 50%;
  background: linear-gradient(135deg,var(--color-primary),#563d8a);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 22px;
  position: relative;
}

.kbc-slider-section .icon-wrap i {
  font-size: 36px;
  color: #fff;
}

/* Soft glow behind icon */
.kbc-slider-section .icon-wrap::after {
  content: "";
  position: absolute;
  inset: -12px;
  border-radius: 50%;
  background: radial-gradient(
    circle,
    rgba(103,78,167,0.25) 0%,
    rgba(103,78,167,0.05) 45%,
    transparent 70%
  );
  z-index: -1;
}

/* ==============================
   LETTER BADGE (K / B / C)
   ============================== */
.kbc-slider-section .kbc-letter-badge {
  width: 40px;
  height: 40px;
  margin-bottom: 14px;
  border-radius: 10px;
  background: var(--color-secondary);
  color: var(--color-default);
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ==============================
   TYPOGRAPHY (NORMALIZED)
   ============================== */
.kbc-slider-section h3 {
  font-size: 1.65rem;
  font-weight: 700;
  color: var(--color-primary);
  margin-bottom: 8px;
}

.kbc-slider-section h4 {
  font-size: 1.3rem;
  font-weight: 600;
  color: var(--color-primary);
  margin-bottom: 6px;
}

.kbc-slider-section p {
  font-size: 0.95rem;
  line-height: 1.55;
  color: #666;
  max-width: 260px;
  margin: 0 auto;
}

/* Divider */
.kbc-slider-section .kbc-divider {
  width: 48px;
  height: 4px;
  margin: 12px auto 18px;
  border-radius: 4px;
  background: linear-gradient(90deg,var(--color-primary),var(--color-secondary));
}

/* ==============================
   SYSTEM ACCENT (ALL CARDS)
   ============================== */
.kbc-slider-section .kbc-card::after,
.kbc-slider-section .behavior-item::after,
.kbc-slider-section .competency-card::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 22px;
  transform: translateX(-50%);
  width: 42px;
  height: 4px;
  border-radius: 4px;
  background: linear-gradient(
    90deg,
    var(--color-primary),
    var(--color-secondary)
  );
  opacity: 0.9;
}

/* ==============================
   PAGINATION
   ============================== */
.kbc-slider-section .swiper-pagination-bullet {
  background: #ccc;
  opacity: 1;
}
.kbc-slider-section .swiper-pagination-bullet-active {
  background: var(--color-primary);
}

/* ==============================
   RESPONSIVE
   ============================== */
@media (max-width: 767px) {
  .kbc-slider-section {
    padding: 40px 16px;
  }

  .kbc-slider-section .kbc-card,
  .kbc-slider-section .behavior-item,
  .kbc-slider-section .competency-card {
    min-height: 340px;
    padding: 36px 22px 50px;
  }

  .kbc-slider-section h3 {
    font-size: 1.45rem;
  }

  .kbc-slider-section h4 {
    font-size: 1.2rem;
  }
}


