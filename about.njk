<style>
/* Timeline Base */
.timeline { position: relative; padding: 2rem 0; }
.timeline::before {
  content: "";
  position: absolute; top: 0; bottom: 0;
  left: 50%; width: 4px;
  background: linear-gradient(180deg,#6d5dfc,#c77dff,#ff85a1);
  background-size: 300% 300%;
  animation: gradientFlow 6s ease infinite;
  transform: translateX(-50%);
  border-radius: 2px; z-index: 0;
}

/* Timeline Items */
.timeline-item { position: relative; display: flex; flex-wrap: wrap; margin-bottom: 6rem; }
.timeline-content, .timeline-img { width: 50%; padding: 1rem; z-index: 1; }
* Modern Image Styling */
.timeline-img {
  position: relative;
  overflow: hidden;
  border-radius: 1.5rem;
padding:1.5rem;
  box-shadow: 0 10px 30px rgba(0,0,0,0.1);
  transition: transform 0.4s ease, box-shadow 0.4s ease;
}
.timeline-img::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: linear-gradient(145deg, rgba(109,93,252,0.2), rgba(199,125,255,0.15));
  opacity: 0;
  transition: opacity 0.4s ease;
  z-index: 1;
}
.timeline-img img {
  width: 100%;
  border-radius: inherit;
  display: block;
  transition: transform 0.6s ease, filter 0.6s ease;
  filter: brightness(0.95) contrast(1.05);
}
.timeline-img:hover {
  transform: translateY(-8px);
  box-shadow: 0 20px 40px rgba(0,0,0,0.25);
}
.timeline-img:hover::before { opacity: 1; }
.timeline-img:hover img {
  transform: scale(1.08);
  filter: brightness(1.05);
}

/* Add glow ring animation (optional aesthetic touch) */
.timeline-img::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: radial-gradient(circle at 50% 50%, rgba(199,125,255,0.3) 0%, transparent 70%);
  opacity: 0;
  transition: opacity 0.6s ease;
  z-index: 2;
}
.timeline-img:hover::after { opacity: 0.8; }
/* Badge */
.timeline-badge {
  position: absolute; top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 90px; height: 90px;
  border-radius: 50%;
  background: linear-gradient(135deg,#6d5dfc,#c77dff);
  color: #fff; font-weight: bold; font-size: 20px;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 8px 24px rgba(0,0,0,0.25);
  z-index: 2;
}
.timeline-badge::before { content: attr(data-year); }

/* Pulse Glow */
.pulse { animation: pulseGlow 2.5s infinite; }
@keyframes pulseGlow {
  0% { box-shadow: 0 0 0 0 rgba(199,125,255,0.6); }
  70% { box-shadow: 0 0 0 25px rgba(199,125,255,0); }
  100% { box-shadow: 0 0 0 0 rgba(199,125,255,0); }
}

/* Cards */
.timeline-text {
  border-radius: 1rem;
  line-height: 1.7;
  font-size: 15px;
}
.glass-card {
  background: rgba(255,255,255,0.92);
  backdrop-filter: blur(14px);
  border: 1px solid rgba(255,255,255,0.3);
  box-shadow: 0 10px 25px rgba(0,0,0,0.1);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}
.glass-card:hover { transform: translateY(-6px); box-shadow: 0 16px 32px rgba(0,0,0,0.15); }
.glass-card h5 { font-size: 1.2rem; color: #5c3f9e; }

/* Alignment */
.timeline-content.left { text-align: right; padding-right: 3rem; margin:auto 0; }
.timeline-content.right { text-align: left; padding-left: 3rem; margin:auto 0; }

/* Heading Gradient */
.text-gradient {
  background: linear-gradient(135deg,#6d5dfc,#c77dff,#ff85a1);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* Mobile */
@media(max-width: 767px) {
  .timeline::before { left: 20px; transform: none; }
  .timeline-content, .timeline-img { width: 100%; text-align: left !important; padding: 1rem !important; }
  .timeline-badge {
    left: -5px; top: -20px; transform: none;
    width: 65px; height: 65px; font-size: 15px;
  }
}
@keyframes gradientFlow {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}
</style>




