<script>
const challenges = {
1: {
statement: "School is unable to compete with bigger schools academically",
reason: "Weak teaching methodology, outdated pedagogy, and lack of structured academic monitoring.",
solution: "Implement Hippocampus 4D Academic Excellence Method (diagnosis, design, delivery, and demonstration of results). Train teachers to adopt structured teaching-learning cycles.",
timeline: "Academic results visibly improve within 12 months."
},
2: {
statement: "Parents move children to other schools frequently",
reason: "Dissatisfaction with learning quality, lack of extracurricular opportunities, and peer pressure to shift to 'brand schools.'",
solution: "Launch a “Parent Engagement Program” + consistent co-curricular activities that build student pride. Create visible “student progress dashboards” for parents.",
timeline: "Retention rates improve in 1–2 admission cycles (9–18 months)."
},
3: {
statement: "Teachers frequently leave, creating instability",
reason: "Lack of professional development, poor support systems, and limited recognition.",
solution: "Introduce continuous teacher training (C-TIES model), performance-linked recognition, and peer learning communities.",
timeline: "Reduced attrition and higher teacher satisfaction within 6–9 months."
},
4: {
statement: "School is seen as “low profile” compared to established competitors",
reason: "Poor marketing, weak storytelling of success, and lack of community presence.",
solution: "Build brand campaigns highlighting student success, social impact, and unique pedagogy. Conduct local events to raise visibility.",
timeline: "Brand visibility improves within 6 months; strong reputation building takes 18–24 months."
},
5: {
statement: "Costs are high, revenue streams unstable",
reason: "Poor resource planning, underutilized assets, and lack of fee discipline.",
solution: "Implement school ERP for fee tracking, optimize resources, and explore alternate revenue (after-school programs, summer camps, skill-based add-ons).",
timeline: "Operational stability achievable within 6–12 months."
},
6: {
statement: "Parents feel disconnected and uninformed",
reason: "No structured communication channel; feedback is ignored or ad-hoc.",
solution: "Create a structured communication calendar (newsletters, WhatsApp flows, PTMs, parent workshops). Deploy transparent feedback mechanisms.",
timeline: "Communication quality improves within 3 months, measurable parent satisfaction within 6–9 months."
}
};

let typingInterval; // keep track of interval

function typeText(element, data, speed = 15) {
clearInterval(typingInterval); // clear any previous typing
const fullText = `Problem Statement:\n${data.statement}\n\nProbable Reason:\n${data.reason}\n\nSolution:\n${data.solution}\n\nTimeline:\n${data.timeline}`;
let i = 0;
element.innerHTML = "";
element.style.opacity = 1;
element.style.transform = "translateY(0)";

// Fade the image during typing
document.getElementById('challenge-image').style.opacity = 0.9;

typingInterval = setInterval(() => {
const text = fullText.substring(0, i+1)
.replace("Problem Statement:", `<span class="statement">Problem Statement:</span>`)
.replace("Probable Reason:", `<span class="reason">Probable Reason:</span>`)
.replace("Solution:", `<span class="solution">Hippocampus Solution:</span>`)
.replace("Timeline:", `<span class="timeline">Hippocampus Timeline:</span>`);
element.innerHTML = text;
i++;
if (i >= fullText.length) clearInterval(typingInterval);
}, speed);
}

// Button click
document.querySelectorAll('.problem-btn').forEach(btn => {
btn.addEventListener('click', () => {
const id = btn.getAttribute('data-id');
const data = challenges[id];
const textContainer = document.getElementById('challenge-text');
const card = document.querySelector('.challenge-card');

// Reset typing and image
clearInterval(typingInterval);
textContainer.style.opacity = 0;
textContainer.style.transform = "translateY(20px)";
document.getElementById('challenge-image').style.opacity = 1; // reset image

// Scroll into view with offset to prevent hiding behind header
if (window.innerWidth <= 768) {
const headerOffset = 100; // adjust based on your header height
const elementPosition = card.getBoundingClientRect().top + window.scrollY;
const offsetPosition = elementPosition - headerOffset;

window.scrollTo({
top: offsetPosition,
behavior: "smooth"
});
}

setTimeout(() => typeText(textContainer, data), 100);
});
});
</script>
