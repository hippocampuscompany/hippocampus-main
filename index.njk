opacity: 1 !important;
z-index: 10;
}
/* Container / swiper base */
.thinker-slider-section { padding: 40px 0; }
.mySwiper1 { width: 100%; position: relative; box-sizing: border-box; }
/* Ensure wrapper doesn't add extra height/space */
.mySwiper1 .swiper-wrapper { align-items: stretch; box-sizing: border-box; }
/* Force each slide to take full container width */
.mySwiper1 .swiper-slide {
display: flex !important;
flex-direction: column;
justify-content: center;
align-items: center;
box-sizing: border-box;
flex: 0 0 100% !important;           /* <-- critical: fixes partial slides */
max-width: 100% !important;          /* <-- safety */
width: 100% !important;              /* <-- safety */
padding: 34px 30px;
height: 260px;
border-radius: 22px;
background: linear-gradient(135deg, #7e71b1, #9184c6);
transition: transform .25s ease;
}
/* Remove transform/translate that might shift slides into view */
.mySwiper1 .swiper-slide .card-text { text-align: center; color: #fff; line-height: 1.55rem; font-weight: 500; }
/* Icon */
.icon { width: 70px; margin-bottom: 12px; }
/* Highlight */
.cid-tXP4EevnkG .highlight { font-weight: 700; color: #ffdf78; display:block; margin-top:14px; font-size:1.35rem; }
/* Nav buttons absolutely positioned so they DON'T consume layout width */
.mySwiper1 .swiper-button-prev,
.mySwiper1 .swiper-button-next {
position: absolute;
top: 50%;
transform: translateY(-50%);
z-index: 20;
width: 40px;
height: 40px;
border-radius: 50%;
background: #fff;
border: 1px solid #dce2ef;
box-shadow: 0 6px 16px rgba(0,0,0,0.12);
display: flex;
align-items: center;
justify-content: center;
}
/* Place prev & next to the edges of the slider */
.mySwiper1 .swiper-button-prev { left: 8px; }
.mySwiper1 .swiper-button-next { right: 8px; }
.mySwiper1 .swiper-button-prev:after,
.mySwiper1 .swiper-button-next:after {
color: #6a58c4;
font-size: 16px;
}
/* Small-screen tweaks */
@media (max-width: 767px) {
.cid-tXP4EevnkG .swiper-slide { height: auto; padding: 22px; }
.mySwiper1 .swiper-button-prev, .mySwiper1 .swiper-button-next { width: 36px; height: 36px; left: 6px; right: 6px; }
}
/* Safety overrides if some other CSS sets swiper-slide to inline or width:auto */
.cid-tXP4EevnkG  .swiper-slide[style] { /* inline styles set by Swiper are respected, but ensure flex-basis is dominant */
flex-basis: 100% !important;
-webkit-flex-basis: 100% !important;
max-width: 100% !important;
}
