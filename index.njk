}

/* Popup */
.feedback-overlay {
position: fixed;
inset: 0;
background: rgba(0,0,0,0.6);
display: none;
align-items: center;
justify-content: center;
z-index: 99999;
}

.feedback-modal {
background: #fff;
border-radius: 18px;
width: 95%;
max-width: 560px;
position: relative;
animation: popupScale 0.25s ease;
}

@keyframes popupScale {
from {
transform: scale(0.9);
opacity: 0;
}
to {
transform: scale(1);
opacity: 1;
}
}

.close-btn {
position: absolute;
top: 12px;
right: 16px;
border: none;
background: none;
font-size: 28px;
cursor: pointer;
}
</style>	
