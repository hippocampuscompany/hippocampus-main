/* Gradient backgrounds for icon circles */
.icon-circle,
.icon-wrapper,
.icon-box {
background: linear-gradient(135deg, var(--grad-start), var(--grad-end));
color: #fff;
display: inline-flex;
align-items: center;
justify-content: center;
border-radius: 50%;
}

/* Sizes for icon wrappers */
.icon-circle,
.icon-wrapper {
width: 70px;
height: 70px;
}

.icon-box {
width: 70px;
height: 70px;
padding: 0;
}

/* Hover card animation */
.hover-card:hover {
transform: translateY(-5px);
box-shadow: 0 12px 24px rgba(0,0,0,0.1);
transition: all 0.3s ease;
}

/* Gradient sets */
.grad-primary { --grad-start: #4e54c8; --grad-end: #8f94fb; }
.grad-success { --grad-start: #43cea2; --grad-end: #185a9d; }
.grad-warning { --grad-start: #f7971e; --grad-end: #ffd200; }
.grad-danger { --grad-start: #e53935; --grad-end: #e35d5b; }
.grad-info { --grad-start: #00c6ff; --grad-end: #0072ff; }
